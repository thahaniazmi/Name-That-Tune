{
  "name": "name-that-tune",
  "version": "0.5.0",
  "description": "Heardle-style song guessing game custom app for Spotify via Spicetify",
  "homepage": "https://github.com/thahaniazmi/Name-That-Tune",
  "repository": {
    "type": "git",
    "url": "https://github.com/thahaniazmi/Name-That-Tune.git"
  },
  "bugs": {
    "url": "https://github.com/thahaniazmi/Name-That-Tune/issues"
  },
  "keywords": [
    "spotify",
    "spicetify",
    "spicetify-custom-apps",
    "spicetify-app",
    "spicetify-extensions",
    "plugins",
    "apps",
    "heardle",
    "game",
    "music-quiz",
    "name-that-tune"
  ],
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --out=dist --minify",
    "build:prod": "pnpm run build:local && pnpm run copy:docs",
    "copy:docs": "copyfiles README.md docs/* dist/",
    "lint": "eslint --fix src",
    "lint:ci": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "update-types": "curl -s -o src/types/spicetify.d.ts https://raw.githubusercontent.com/spicetify/cli/main/globals.d.ts"
  },
  "license": "GPL-3.0",
  "engines": {
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm",
    "pnpm": ">=9",
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "18.3.1",
    "@types/react-dom": "19.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "copyfiles": "^2.4.1",
    "dice-coefficient": "^2.1.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "i18next": "^26.5.11",
    "postcss": "^8.5.26",
    "postcss-modules": "^9.0.1",
    "react-i18next": "^17.1.9",
    "sass-embedded": "^1.107.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": "0.16.8",
      "brace-expansion@<1.1.18": "1.1.18",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2"
    }
  }
}
